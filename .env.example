# Copy this file to .env and fill in your values. Never commit .env.
# With no API key set, the system runs on the offline mock provider.

# xAI Grok API key
XAI_API_KEY=

# OpenAI-compatible endpoint for xAI
XAI_BASE_URL=https://api.x.ai/v1

# Models per role: a cheaper model for extraction, a stronger one for approval.
# Leave blank to use the defaults in the config module.
EXTRACTION_MODEL=
APPROVAL_MODEL=

# SQLite database for inventory, vendors, and the processed-invoice ledger
INVOICE_DB_PATH=inventory.db

# Optional token prices per million tokens. Set both to show estimated cost in batch metrics.
INVOICE_PRICE_IN_PER_MTOK=
INVOICE_PRICE_OUT_PER_MTOK=
